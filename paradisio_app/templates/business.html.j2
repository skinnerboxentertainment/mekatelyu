{#-
  One business profile.

  Autoescaping is on, so every value interpolated here is escaped unless it is
  explicitly marked safe. The only values marked safe are our own inline SVG
  icons. That replaces the previous arrangement, where correct escaping depended
  on remembering html.escape() at each of several dozen interpolation sites.
-#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="{{ asset_prefix }}static/favicon.ico"><link rel="icon" type="image/png" sizes="32x32" href="{{ asset_prefix }}static/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="{{ asset_prefix }}static/favicon-16x16.png"><link rel="apple-touch-icon" href="{{ asset_prefix }}static/apple-touch-icon.png">
<title>{{ page.name }} — {{ page.area }} — Whappin Puerto Viejo</title>
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self' https://*.tile.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests">
<link rel="canonical" href="{{ canonical }}">
{%- for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url }}">
{%- endfor %}
<meta property="og:title" content="{{ page.name }} — Whappin Puerto Viejo">
<meta property="og:description" content="{{ page.name }} · {{ page.area }}">
<meta property="og:type" content="website">
<link rel="stylesheet" href="{{ asset_prefix }}static/tokens.css?v={{ page.taxonomy_version }}">
<link rel="stylesheet" href="{{ asset_prefix }}static/styles.css?v={{ page.taxonomy_version }}">
<link rel="stylesheet" href="{{ asset_prefix }}static/vendor/leaflet/leaflet.css">
<script src="{{ asset_prefix }}static/vendor/leaflet/leaflet.js"></script>
<meta name="description" content="{{ page.name }} — {{ page.category_label }} · {{ page.area }}">
</head>
<body>
<nav class="site-nav" aria-label="Primary navigation"><a href="../index.html" class="site-logo">Whappin Puerto Viejo</a><a href="../index.html" class="nav-active">{{ t("nav.back_to_directory") }}</a>{% include "partials/language_switch.html.j2" %}</nav>
<main class="container">
<header class="header biz-header">
<a href="../index.html" class="back-link">&larr; {{ t("nav.back_to_directory") }}</a>
<h1>{{ page.name }}</h1>
<div class="biz-meta">
<span class="biz-category">{{ page.category_label }}</span>
<span class="biz-area">{{ page.area }}</span>
{%- if page.status_label %}
<span class="biz-status status-{{ page.status }}">{{ page.status_label }}</span>
{%- endif %}
</div>
{%- if page.facets %}
<div class="amenities semantic-facets" aria-label="{{ t('biz.types_qualities') }}">{% for facet in page.facets %}<span class="amenity-chip">{{ facet }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- endif %}
<div class="badge-row">{% for badge in page.badges %}<span class="badge badge-{{ badge.lower().replace(' ', '-') }}">{{ badge }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- if page.rating %}
<div class="biz-rating">{{ '★' * page.rating.full_stars }}{% if page.rating.half_star %}&#189;{% endif %} {{ page.rating.value }} <span class="rating-source">{{ page.rating.source }}</span></div>
{%- endif %}
{%- if page.address %}
<div class="biz-addr"><span class="addr-label">&#128205; {{ page.address }}</span> <button class="addr-copy" data-addr-copy>{{ t("biz.copy") }}</button></div>
{%- endif %}
{%- if page.hours_header.mode == 'verified_placeholder' %}
<div class="biz-hours"><span class="biz-status-placeholder" data-verified-status></span></div>
{%- elif page.hours_header.mode == 'legacy' %}
<div class="biz-hours">
{%- if page.hours_header.status %}<span class="{{ 'biz-open' if page.hours_header.status.is_open else 'biz-closed' }}" data-legacy-status>{{ page.hours_header.status.label }}</span>{% endif %}
{%- if page.hours_header.hours_line %}<span class="biz-hours-line">{{ page.hours_header.hours_line }}</span>{% endif %}
{%- if page.hours_header.check %}<span class="biz-check">{{ page.hours_header.check }}</span>{% endif %}
</div>
{%- endif %}
{%- if page.weekly_hours %}
{%- set wh = page.weekly_hours %}
<section class="hours-section" aria-labelledby="hours-heading" data-hours-payload="{{ wh.payload_json }}"><h2 class="section-heading" id="hours-heading">{{ t("biz.hours") }}</h2><p class="hours-source">{{ wh.provenance | join(' · ') }}</p><p class="hours-tz">{{ t("biz.hours_timezone") }}</p>
{%- if wh.collapsed %}
<details class="disclosure hours-disclosure"><summary><span class="when-closed">{{ t("biz.hours_view_week") }} <span class="chevron" aria-hidden="true">&#9660;</span></span><span class="when-open">{{ t("biz.hours_view_less") }} <span class="chevron" aria-hidden="true">&#9650;</span></span></summary>{% include 'partials/hours_table.html.j2' %}</details>
{%- else %}
{% include 'partials/hours_table.html.j2' %}
{%- endif %}
</section>
{%- endif %}
{%- if page.amenities %}
<div class="amenities-section"><strong class="amenities-heading">{{ t("biz.amenities") }}</strong>
{%- if page.amenities.collapsed %}
<details class="disclosure amenities-disclosure"><summary><span class="when-closed">{{ t("biz.amenities_all", n=page.amenities.total) }} <span class="chevron" aria-hidden="true">&#9660;</span></span><span class="when-open">{{ t("biz.amenities_less") }} <span class="chevron" aria-hidden="true">&#9650;</span></span></summary><div class="amenities">{% for item in page.amenities['items'] %}<span class="amenity-chip">{{ item }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div></details>
{%- else %}
<div class="amenities">{% for item in page.amenities['items'] %}<span class="amenity-chip">{{ item }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- endif %}
</div>
{%- endif %}
{%- if page.attributes %}
{%- set attrs = page.attributes %}
<section class="attributes-section" aria-labelledby="details-heading"><h2 class="section-heading" id="details-heading">{{ t("biz.details") }}</h2><p class="details-source">{{ t("biz.details_from") }} <a href="https://www.google.com/maps?cid={{ attrs.cid }}" target="_blank" rel="noopener">Google Maps</a>{% if attrs.updated %} · {{ attrs.updated }}{% endif %}</p>
{%- if attrs.collapsed %}
<div class="details-summary" aria-label="{{ t('biz.details_highlight') }}">{% for value in attrs.summary %}<span class="attr-chip">{{ value }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div><details class="disclosure details-disclosure"><summary><span class="when-closed">{{ t("biz.details_view_all", n=attrs.total) }} <span class="chevron" aria-hidden="true">&#9660;</span></span><span class="when-open">{{ t("biz.details_view_less") }} <span class="chevron" aria-hidden="true">&#9650;</span></span></summary><div class="details-groups" id="details-groups">{% include 'partials/attribute_groups.html.j2' %}</div></details>
{%- else %}
<div class="attr-groups">{% include 'partials/attribute_groups.html.j2' %}</div>
{%- endif %}
</section>
{%- endif %}
{%- if page.prices %}
<div class="biz-prices">{% for price in page.prices %}<span class="price-chip">{{ price }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- endif %}
{%- if page.freshness %}
<div class="biz-freshness">{{ page.freshness }}</div>
{%- endif %}
</header>
{%- if page.primary_contact.type != 'None' %}
<div class="biz-main hide-mobile">
<a href="{{ page.primary_contact.url }}" class="primary-cta" target="_blank" rel="noopener" data-plausible-event="ContactClick" data-plausible-channel="{{ page.primary_contact.type }}">{{ icons.get(page.primary_contact.type, '') | safe }} {{ page.primary_contact.label }}</a>
</div>
{%- endif %}
<div class="biz-desc">
<p>{{ page.description }}</p>
</div>
<div class="biz-content">
<div class="biz-links">{% for link in page.secondary_links %}<a href="{{ link.url }}" class="secondary-link" target="_blank" rel="noopener">{{ icons.get(link.label, '') | safe }} {{ link.display | default(link.label) }}</a>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- if page.map %}
<div class="biz-map">
<div id="map-{{ page.slug }}" class="map-container" data-business-map data-lat="{{ page.map.lat }}" data-lng="{{ page.map.lng }}"></div>
<p class="map-note"><a href="{{ page.map.open_url }}" target="_blank" rel="noopener">{{ t("biz.open_maps_arrow") }} &rarr;</a></p>
</div>
{%- endif %}
<div class="share-row">
<button class="share-trigger" data-share-trigger>{{ t("biz.share_this") }} &#183; <span class="share-icon">&#8600;</span></button>
</div>
<div class="share-sheet" data-share-sheet hidden>
<div class="share-sheet-inner">
<button class="share-option" data-share-copy>{{ t("biz.share_copy_link") }}</button>
<a href="#" class="share-option" data-share-wa target="_blank" rel="noopener">{{ t("biz.share_whatsapp") }}</a>
<button class="share-option" data-share-toggle-qr>{{ t("biz.share_show_qr") }}</button>
<button class="share-option share-close" data-share-close>{{ t("biz.share_close") }}</button>
</div>
<div class="share-qr" data-share-qr-panel hidden>
<img src="{{ asset_prefix }}qr/{{ page.slug }}.png" alt="{{ t('biz.qr_alt', name=page.name) }}" width="200" height="200" loading="lazy">
<a href="{{ asset_prefix }}qr/{{ page.slug }}.png" class="qr-download-link" download>{{ t("biz.share_download_qr") }}</a>
</div>
</div>
</div>
<footer class="footer">
<p><a href="{{ report_url }}" target="_blank" rel="noopener">{{ t("footer.suggest_edit") }}</a> &middot; <a href="https://github.com/skinnerboxentertainment/mekatelyu/issues/new?template=qa-feedback.md&title=QA:%20{{ page.slug }}" target="_blank" rel="noopener">{{ t("footer.report_problem") }}</a></p>
</footer>
<div class="sticky-bar">
{%- for action in page.sticky_actions -%}
{%- if action.kind == 'directions' -%}
<a href="{{ action.url }}" class="sticky-directions" target="_blank" rel="noopener">{{ icons[action.icon] | safe }} {{ action.label }}</a>
{%- elif action.kind == 'call' -%}
{%- if action.external -%}
<a href="{{ action.url }}" class="sticky-call" target="_blank" rel="noopener" data-plausible-event="ContactClick" data-plausible-channel="{{ action.channel }}">{{ icons[action.icon] | safe }} {{ action.label }}</a>
{%- else -%}
<a href="{{ action.url }}" class="sticky-call" data-plausible-event="ContactClick" data-plausible-channel="{{ action.channel }}">{{ icons[action.icon] | safe }} {{ action.label }}</a>
{%- endif -%}
{%- else -%}
<button class="sticky-share" data-share-trigger>{{ icons[action.icon] | safe }} {{ action.label }}</button>
{%- endif -%}
{%- endfor -%}
</div>
</main>
<script src="{{ asset_prefix }}static/ui-{{ lang }}.js?v={{ page.taxonomy_version }}"></script>
<script src="{{ asset_prefix }}static/detail.js?v={{ page.taxonomy_version }}"></script>
</body>
</html>
