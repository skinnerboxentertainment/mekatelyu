{
  "name": "amenity-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Google Maps amenity enrichment pipeline via Playwright ARIA snapshots",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "amenities:one": "tsx src/cli.ts one",
    "amenities:batch": "tsx src/cli.ts batch",
    "about:one": "tsx src/cli.ts one --mode about",
    "about:batch": "tsx src/cli.ts batch --mode about",
    "hours:one": "tsx src/cli.ts one --mode hours",
    "hours:batch": "tsx src/cli.ts batch --mode hours",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
